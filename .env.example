JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h
ADMIN_EMAIL=admin@courtflow.local
ADMIN_NAME=Court Administrator
ADMIN_PASSWORD=replace-with-your-own-password
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://jane-amongst-obligations-merge.trycloudflare.com
MAX_UPLOAD_MB=10
# For running the backend outside Docker (MongoDB must use a replica set):
DATABASE_URL=mongodb://localhost:27017/courtflow?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
